@article{auerHaveTrendfollowingSignals2021a,
  title = {Have Trend-Following Signals in Commodity Futures Markets Become Less Reliable in Recent Years?},
  author = {Auer, Benjamin R.},
  date = {2021-12-01},
  journaltitle = {Financial Markets and Portfolio Management},
  shortjournal = {Financ Mark Portf Manag},
  volume = {35},
  number = {4},
