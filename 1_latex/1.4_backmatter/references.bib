@article{haoDynamicConnectednessHigher2024,
  title = {Dynamic Connectedness in the Higher Moments between Clean Energy and Oil Prices},
  author = {Hao, Wei and Pham, Linh},
  date = {2024-12-01},
  journaltitle = {Energy Economics},
  shortjournal = {Energy Economics},
  volume = {140},
  pages = {107987},
