      \field{issn}{2373-8529}
      \field{journaltitle}{Financial Markets and Portfolio Management}
      \field{langid}{english}
      \field{month}{12}
      \field{number}{4}
      \field{shortjournal}{Financ Mark Portf Manag}
      \field{title}{Have Trend-Following Signals in Commodity Futures Markets Become Less Reliable in Recent Years?}
